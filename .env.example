# Google Cloud & Vertex AI Settings (No raw API keys committed!)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret IDs (fetched at runtime via SecretManagerServiceClient)
GEMINI_API_KEY_SECRET_ID=resolutions-2027-gemini-api-key
DB_CONNECTION_SECRET_ID=resolutions-2027-session-db-url
HITL_SIGNING_SECRET_ID=resolutions-2027-hitl-signing-secret

# Persistent Session & Memory Store Configuration
SESSION_BACKEND=database
FIRESTORE_COLLECTION=resolutions_2027_memories
VERTEX_AGENT_ENGINE_ID=
VERTEX_SEARCH_DATA_STORE_ID=

# Model Routing Configuration
FAST_MODEL_NAME=gemini-2.5-flash
PRO_MODEL_NAME=gemini-2.5-pro

# Observability & DLP Redaction
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
LOG_LEVEL=INFO
